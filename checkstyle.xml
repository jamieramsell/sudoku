<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle configuration for the sudoku project.

  This deliberately diverges from Checkstyle's default (Sun/Google) naming
  rules: variables, fields and parameters use snake_case, and constants use
  SCREAMING_SNAKE_CASE. Class, interface, package and method names still follow
  standard Java camelCase conventions.
-->
<module name="Checker">
  <property name="charset" value="UTF-8"/>
  <property name="severity" value="error"/>

  <module name="TreeWalker">
    <!-- Naming conventions (adapted for the project's snake_case style) -->
    <module name="ConstantName">
      <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
    </module>
    <module name="LocalVariableName">
      <property name="format" value="^[a-z][a-z0-9]*(_[a-z0-9]+)*$"/>
    </module>
    <module name="LocalFinalVariableName">
      <property name="format" value="^[a-z][a-z0-9]*(_[a-z0-9]+)*$"/>
    </module>
    <module name="MemberName">
      <property name="format" value="^[a-z][a-z0-9]*(_[a-z0-9]+)*$"/>
    </module>
    <module name="ParameterName">
      <property name="format" value="^[a-z][a-z0-9]*(_[a-z0-9]+)*$"/>
    </module>
    <module name="MethodName">
      <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
    </module>
    <module name="ClassTypeParameterName">
      <property name="format" value="^[A-Z][0-9]?$"/>
    </module>
    <module name="MethodTypeParameterName">
      <property name="format" value="^[A-Z][0-9]?$"/>
    </module>
    <module name="PackageName"/>
    <module name="TypeName"/>

    <!-- Imports -->
    <module name="RedundantImport"/>
    <module name="UnusedImports"/>

    <!-- Javadoc on public API, as required by CLAUDE.md -->
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="allowMissingPropertyJavadoc" value="true"/>
      <property name="allowedAnnotations" value="Override, Test, Before, After, BeforeClass, AfterClass"/>
    </module>
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>

    <!-- General code quality -->
    <module name="EqualsHashCode"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="EmptyStatement"/>
  </module>

  <!-- LineLength must be a direct child of Checker, not TreeWalker. -->
  <module name="LineLength">
    <property name="max" value="150"/>
    <property name="ignorePattern" value="^import |^package |@see |@link"/>
  </module>
</module>
